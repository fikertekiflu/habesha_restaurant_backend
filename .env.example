# Copy to .env for local, or set these in the Render dashboard.

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (Network Access must allow Render: 0.0.0.0/0)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/habesha?retryWrites=true&w=majority

# Strong random string for JWT cookies / auth
JWT_SECRET=change-me-to-a-long-random-secret

# Exact Vercel production URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# Optional: comma-separated extra origins (Vercel previews)
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main-user.vercel.app
